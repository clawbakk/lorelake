{
  "type": "object",
  "required": ["version", "asOf", "agent", "date", "gaps", "ranges"],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "asOf": {"type": "string"},
    "agent": {"type": "string"},
    "date": {"type": "string"},
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "severity", "cause", "since", "attempts", "stuck", "claims"],
        "properties": {
          "page": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["major", "minor"]},
          "cause": {"type": "string", "enum": ["declared", "flagged", "writer-failed", "reverted", "run-cap",
                                                "timeout", "infra", "unverified", "blurb"]},
          "since": {"type": "string"},
          "attempts": {"type": "integer"},
          "stuck": {"type": "boolean"},
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["quote", "head", "severity", "source"],
              "properties": {
                "quote": {"type": "string", "minLength": 1},
                "head": {"type": "string"},
                "severity": {"type": "string", "enum": ["major", "minor"]},
                "source": {"type": "string", "enum": ["brief", "verifier:residual", "verifier:accuracy",
                                                      "check:removed-name", "check:quote-residue",
                                                      "check:anchor", "writer:other"]}
              }
            }
          }
        }
      }
    },
    "ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["base", "head", "cause", "leads"],
        "properties": {
          "base": {"type": "string"},
          "head": {"type": "string"},
          "cause": {"type": "string", "enum": ["analysis-failed"]},
          "leads": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
