{
  "type": "object",
  "additionalProperties": false,
  "required": ["pages", "otherStale"],
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "status", "claimsLeft", "rejected", "note"],
        "properties": {
          "page": {"type": "string"},
          "status": {"type": "string", "enum": ["corrected", "declared-gap", "no-change"]},
          "claimsLeft": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
          "rejected": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    },
    "otherStale": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "quote", "head", "severity"],
        "properties": {
          "page": {"type": "string"},
          "quote": {"type": "string"},
          "head": {"type": "string"},
          "severity": {"type": "string", "enum": ["major", "minor"]}
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "head", "severity"],
      "properties": {
        "quote": {"type": "string"},
        "head": {"type": "string"},
        "severity": {"type": "string", "enum": ["major", "minor"]}
      }
    }
  }
}
